# Copy this file to .env and fill in real values. Never commit the real .env.
# Load these with `pip install django-environ` + a couple lines in settings.py,
# or export them in your shell / hosting platform's environment settings.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# --- File storage (pick ONE, or leave both blank to stay on local /media) ---

# Option 1: Cloudinary (recommended starting point — free tier, easiest setup)
# Get this from your Cloudinary dashboard after signing up free.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Option 2: AWS S3 or DigitalOcean Spaces (set these instead, when you outgrow Cloudinary)
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com   # only needed for DO Spaces, omit for AWS S3
